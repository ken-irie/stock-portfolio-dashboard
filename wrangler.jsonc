{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stock-portfolio",
  "main": "worker/worker.js",
  "compatibility_date": "2026-09-01",

  // dist/ は worker/build.mjs が作る公開用フォルダ。
  // run_worker_first: true にして、必ずログイン判定を通してから返す
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // APP_PASSWORD / SUPABASE_URL / SUPABASE_KEY は
  // `npx wrangler secret put <名前>` で登録する（Gitには含めない）

  "observability": { "enabled": true }
}
